---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'About Us' },
  { href: '/connect', label: 'Connect' },
  { href: '/resources', label: 'Resources' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Night theme (8:00 PM to 7:59 AM) — set before paint to avoid flashing -->
    <script is:inline>
      (function () {
        const hour = new Date().getHours();
        if (hour >= 20 || hour < 8) {
          document.documentElement.classList.add('night');
        }
      })();
    </script>

    <!-- Google Fonts: Body Text Only -->
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans&display=swap" rel="stylesheet" />

    <!-- Adobe Fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/ewz8zez.css" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4KX380T5BD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4KX380T5BD');
    </script>
  </head>

  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="Urbanism Club home">
          <img src="/pictures/urbanism-club-logo.png" alt="Title of the website: Urbanism Club" />
        </a>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <a href="/" aria-label="Urbanism Club home">
          <img src="/media/urbanism-club-skyline.jpg" alt="Urbanism Club" />
        </a>
      </div>
    </footer>
  </body>
</html>
