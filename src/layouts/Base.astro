---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/global.css';
// Wordmark only (no skyline): cropped from the full logo PNGs.
import navLogo from '../assets/urbanism-club-logo-wordmark.png';
import navLogoInverted from '../assets/urbanism-club-logo-wordmark-inverted.png';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage = '/og-image.png', noindex = false } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;

// Internal links end in a slash, the URLs Netlify serves: /connect costs a 301 to /connect/ first,
// which also turned the Join pill on Connect into a full reload instead of a scroll.
const path = Astro.url.pathname.replace(/\/?$/, '/');
const nav = [
  { href: '/', label: 'About Us' },
  { href: '/connect/', label: 'Connect' },
  { href: '/resources/', label: 'Resources' },
];
// The Join pill opens the mailing-list section on Connect, right below the QR codes.
const cta = { href: '/connect/#join', label: 'Join' };

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const gaId = site.google_analytics_id;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#007ea3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {site.google_site_verification && (
      <meta name="google-site-verification" content={site.google_site_verification} />
    )}

    {/* Share cards */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.site_name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.site_name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Night theme (8:00 PM to 7:59 AM) before paint to avoid flashing, plus post-load
        smooth scrolling so cross-page #section links still jump straight to the target. */}
    <script is:inline>
      (function () {
        var h = new Date().getHours();
        if (h >= 20 || h < 8) {
          document.documentElement.classList.add('night');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#ffffff');
        }
        addEventListener('load', function () {
          setTimeout(function () {
            document.documentElement.classList.add('smooth-scroll');
          });
        });
      })();
    </script>

    {/* Preconnect to font origins to save DNS/TLS latency on the critical path */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />

    {/* Google Fonts: Body Text Only */}
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans&display=swap" rel="stylesheet" />

    {/* Adobe Fonts */}
    <link rel="stylesheet" href="https://use.typekit.net/ewz8zez.css" />

    {gaId && (
      <>
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="nav" aria-label="Main">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label={`${site.site_name} home`}>
          <Image class="logo-day" src={navLogoInverted} alt="" width={200} densities={[1, 2]} format="webp" loading="eager" />
          <Image class="logo-night" src={navLogo} alt="" width={200} densities={[1, 2]} format="webp" loading="lazy" />
        </a>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={cta.href} class="nav-cta">
              {cta.label}
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <nav class="footer-nav" aria-label="Footer">
          <ul>
            {[...nav, cta].map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        {site.contact_email && (
          <p class="footer-contact">
            Questions? <a href={`mailto:${site.contact_email}`}>{site.contact_email}</a>
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
