---
import { Image, getImage } from 'astro:assets';
import '../styles/global.css';
import navLogo from '../assets/urbanism-club-logo.png';
import skyline from '../assets/urbanism-club-skyline.jpg';
import ovalLightSrc from '../assets/cincinnati-street-network-oval-light.png';
import ovalDarkSrc from '../assets/cincinnati-street-network-oval-dark.png';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'About Us' },
  { href: '/connect', label: 'Connect' },
  { href: '/events', label: 'Events' },
  { href: '/resources', label: 'Resources' },
];

const ovalLight = await getImage({ src: ovalLightSrc, width: 1200, format: 'webp', quality: 50 });
const ovalDark = await getImage({ src: ovalDarkSrc, width: 1200, format: 'webp', quality: 50 });
---

<html lang="en" style={`--oval-light: url(${ovalLight.src}); --oval-dark: url(${ovalDark.src});`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Night theme (8:00 PM to 7:59 AM) — set before paint to avoid flashing -->
    <script is:inline>
      (function () {
        const hour = new Date().getHours();
        if (hour >= 20 || hour < 8) {
          document.documentElement.classList.add('night');
        }
      })();
    </script>

    <!-- Google Fonts: Body Text Only -->
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans&display=swap" rel="stylesheet" />

    <!-- Adobe Fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/ewz8zez.css" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4KX380T5BD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4KX380T5BD');
    </script>
  </head>

  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="Urbanism Club home">
          <Image src={navLogo} alt="Title of the website: Urbanism Club" width={240} densities={[1, 2]} format="webp" loading="eager" />
        </a>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <a href="/" aria-label="Urbanism Club home">
          <Image src={skyline} alt="Urbanism Club" width={180} densities={[1, 2]} format="webp" />
        </a>
      </div>
    </footer>
  </body>
</html>
