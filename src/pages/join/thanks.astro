---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const page = (await getEntry('pages', 'join'))!.data as Record<string, any>;
---

<Base title={page.seo_title} description={page.seo_description} noindex>
  <main class="site">
    <h2>{page.heading}</h2>
    <p>{page.thanks_text}</p>
  </main>
</Base>
