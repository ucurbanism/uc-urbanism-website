---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const page = (await getEntry('pages', 'join'))!.data as Record<string, any>;
const site = (await getEntry('settings', 'site'))!.data;
const connect = (await getEntry('pages', 'connect'))!.data as Record<string, any>;

const groupMe = site.qr_links.find((q: { label: string }) => q.label === 'GroupMe');
const instagram = site.text_links.find((l: { label: string }) => l.label === 'Instagram');
---

<Base title={page.thanks_seo_title ?? page.seo_title} description={page.seo_description} noindex>
  <main class="site" id="main">
    <h1 class="page-title">{page.thanks_heading ?? page.heading}</h1>
    <p class="lede">{page.thanks_text}</p>

    <h2>{page.thanks_next_heading ?? 'What happens next'}</h2>
    {page.thanks_next_text && <p>{page.thanks_next_text}</p>}

    <div class="lines">
      <p><strong>Meetings:</strong> {connect.meetings_address}</p>
    </div>

    <div class="cta">
      <div class="cta-actions">
        {groupMe && <a class="btn btn--primary" href={groupMe.url}>Join the GroupMe</a>}
        <a class="btn btn--secondary" href="/events">See upcoming events</a>
      </div>
      <p class="cta-note">
        More about the club on <a href="/connect">Connect</a>{instagram && <> or <a href={instagram.url}>Instagram</a></>}.
      </p>
    </div>
  </main>
</Base>
