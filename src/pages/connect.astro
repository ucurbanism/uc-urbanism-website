---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { md, lines } from '../lib/text';
import almsPhoto from '../assets/alms-6110-studio.jpg';

const page = (await getEntry('pages', 'connect'))!.data as Record<string, any>;
const site = (await getEntry('settings', 'site'))!.data;
---

<Base title={page.seo_title} description={page.seo_description}>
  <main class="site">
    <h2>{page.get_connected_heading}</h2>
    <Fragment set:html={md(page.get_connected_text)} />

    <div class="qr-grid">
      {site.qr_links.map((q) => (
        <a href={q.url}>
          <img src={q.image} alt="" />
          {q.label}
        </a>
      ))}
    </div>

    <div class="embed embed--natural">
      <iframe class="instagram-media instagram-media-rendered" id="instagram-embed-0" src={page.instagram_embed_src} allowtransparency="true" allowfullscreen="true" frameborder="0" height="688" data-instgrm-payload-id="instagram-media-payload-0" scrolling="no" loading="lazy" style="background: white; width: calc(100% - 2px); border-radius: 3px; border: 1px solid rgb(219, 219, 219); box-shadow: none; display: block; margin: 0px 0px 12px; min-width: 326px; padding: 0px;"></iframe>
    </div>
    <script is:inline async src="https://www.instagram.com/embed.js"></script>
    <div class="lines">
      {site.text_links.map((l) => (
        <p><a href={l.url}>{l.label}</a></p>
      ))}
    </div>

    <h2>{page.meetings_heading}</h2>
    <div class="lines lines--flow">
      {lines(page.meetings_lines).map((l, i) => <>{i > 0 && ' '}<p>{l}</p></>)}
    </div>
    <p>{page.meetings_address}</p>

    <div class="image">
      <p><Image src={almsPhoto} alt={page.meetings_photo_alt} widths={[480, 750, 1500]} sizes="(max-width: 782px) 100vw, 750px" format="webp" loading="lazy" /></p>
    </div>
  </main>
</Base>
