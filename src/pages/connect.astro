---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { md, lines } from '../lib/text';
import almsPhoto from '../assets/alms-6110-studio.jpg';

const page = (await getEntry('pages', 'connect'))!.data as Record<string, any>;
const site = (await getEntry('settings', 'site'))!.data;
---

<Base title={page.seo_title} description={page.seo_description}>
  <main class="site" id="main">
    <h1 class="page-title">{page.get_connected_heading}</h1>

    <!-- One Google Calendar URL, two views: an agenda list of what's next, then the month grid. -->
    <section id="events" class="anchor-target">
      {page.calendar_text && <p class="embed-caption">{page.calendar_text}</p>}
      <div class="embed embed--agenda">
        <iframe title="Upcoming Urbanism Club events (list)" src={`${page.calendar_src}&mode=AGENDA`} style="border:solid 1px #007ea3" frameborder="0" scrolling="no" loading="lazy"></iframe>
      </div>
      <div class="embed">
        <iframe title="Urbanism Club events calendar (month)" src={page.calendar_src} style="border:solid 1px #007ea3" frameborder="0" scrolling="no" loading="lazy"></iframe>
      </div>
    </section>

    <Fragment set:html={md(page.get_connected_text)} />

    {page.qr_note && <p class="qr-note">{page.qr_note}</p>}
    <div class="qr-grid">
      {site.qr_links.map((q) => (
        <a href={q.url}>
          <img src={q.image} alt="" width="200" height="200" />
          {q.label}
        </a>
      ))}
    </div>
    <div class="lines">
      {site.text_links.map((l) => (
        <p><a href={l.url}>{l.label}</a></p>
      ))}
    </div>

    <div class="embed embed--natural">
      <iframe title="Urbanism Club on Instagram" class="instagram-media instagram-media-rendered" id="instagram-embed-0" src={page.instagram_embed_src} allowtransparency="true" allowfullscreen="true" frameborder="0" height="688" data-instgrm-payload-id="instagram-media-payload-0" scrolling="no" loading="lazy"></iframe>
    </div>
    <script is:inline async src="https://www.instagram.com/embed.js"></script>

    <h2 id="meetings" class="anchor-target">{page.meetings_heading}</h2>
    <div class="lines lines--flow">
      {lines(page.meetings_lines).map((l, i) => <>{i > 0 && ' '}<p>{l}</p></>)}
    </div>
    <p>{page.meetings_address}</p>

    <div class="image">
      <p><Image src={almsPhoto} alt={page.meetings_photo_alt} widths={[480, 750, 1500]} sizes="(max-width: 782px) 100vw, 750px" format="webp" loading="lazy" /></p>
    </div>
  </main>
</Base>

