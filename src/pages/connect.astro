---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { md, lines } from '../lib/text';
import almsPhoto from '../assets/alms-6110-studio.jpg';

const page = (await getEntry('pages', 'connect'))!.data as Record<string, any>;
const site = (await getEntry('settings', 'site'))!.data;
const groupMe = site.qr_links.find((q) => q.label === 'GroupMe');
// Each QR code is already labelled with a link, so only list text links that no QR code covers.
const qrLabels = new Set(site.qr_links.map((q) => q.label.toLowerCase()));
const extraLinks = site.text_links.filter((l) => !qrLabels.has(l.label.toLowerCase()));
---

<Base title={page.seo_title} description={page.seo_description}>
  <main class="site" id="main">
    <h1 class="page-title">{page.get_connected_heading}</h1>
    <div class="lede" set:html={md(page.get_connected_text)} />

    {page.qr_note && <p class="qr-note">{page.qr_note}</p>}
    <div class="qr-grid">
      {site.qr_links.map((q) => (
        <a href={q.url}>
          <img src={q.image} alt="" width="200" height="200" />
          {q.label}
        </a>
      ))}
    </div>
    {extraLinks.length > 0 && (
      <div class="lines">
        {extraLinks.map((l) => (
          <p><a href={l.url}>{l.label}</a></p>
        ))}
      </div>
    )}

    <!-- Mailing list: signup is a club-owned Google Form. The nav's Join pill links here. -->
    <section id="join" class="anchor-target">
      <h2>{page.join_heading}</h2>
      {page.signup_url ? (
        <>
          {page.join_intro_text && <p>{page.join_intro_text}</p>}
          <div class="cta-actions">
            <a class="btn btn--primary" href={page.signup_url}>{page.signup_label ?? 'Sign up'}</a>
          </div>
          {page.privacy_note && <p class="cta-note">{page.privacy_note}</p>}
        </>
      ) : (
        // No Google Form linked yet: the mailing-list pill is a placeholder (goes to the 404)
        // until signup_url is set, and the GroupMe carries announcements in the meantime.
        <>
          {page.join_fallback_text && <p>{page.join_fallback_text}</p>}
          <div class="cta-actions">
            <a class="btn btn--primary" href="/404">{page.signup_label ?? 'Join the mailing list'}</a>
            {groupMe && <a class="btn btn--secondary" href={groupMe.url}>Join the GroupMe</a>}
          </div>
        </>
      )}
    </section>

    <!-- One Google Calendar URL, two views: an agenda list of what's next, then the month grid. -->
    <section id="events" class="anchor-target">
      <h2>{page.events_heading}</h2>
      {page.calendar_text && <p class="embed-caption">{page.calendar_text}</p>}
      <div class="embed embed--agenda">
        <iframe title="Upcoming Urbanism Club events (list)" src={`${page.calendar_src}&mode=AGENDA`} style="border:solid 1px #007ea3" frameborder="0" scrolling="no" loading="lazy"></iframe>
      </div>
      <div class="embed">
        <iframe title="Urbanism Club events calendar (month)" src={page.calendar_src} style="border:solid 1px #007ea3" frameborder="0" scrolling="no" loading="lazy"></iframe>
      </div>
    </section>

    <!-- Meeting polls: the club's own poll site (a names-only fork of Timeful). Hidden until its address is set. -->
    {page.schedule_embed_src && (
      <section id="schedule" class="anchor-target">
        <h2>{page.schedule_heading}</h2>
        {page.schedule_text && <p class="embed-caption">{page.schedule_text}</p>}
        <div class="embed embed--poll">
          <iframe title="Meeting poll" src={page.schedule_embed_src} style="border:solid 1px #007ea3" frameborder="0" loading="lazy" allow="clipboard-write"></iframe>
        </div>
        <p class="cta-note"><a href={page.schedule_embed_src}>Open the poll site in its own tab</a></p>
      </section>
    )}

    <div class="embed embed--natural">
      <iframe title="Urbanism Club on Instagram" class="instagram-media instagram-media-rendered" id="instagram-embed-0" src={page.instagram_embed_src} allowtransparency="true" allowfullscreen="true" frameborder="0" height="688" data-instgrm-payload-id="instagram-media-payload-0" scrolling="no" loading="lazy"></iframe>
    </div>
    <script is:inline async src="https://www.instagram.com/embed.js"></script>

    <h2 id="meetings" class="anchor-target">{page.meetings_heading}</h2>
    <div class="lines lines--flow">
      {lines(page.meetings_lines).map((l, i) => <>{i > 0 && ' '}<p>{l}</p></>)}
    </div>
    <p>{page.meetings_address}</p>

    <div class="image">
      <p><Image src={almsPhoto} alt={page.meetings_photo_alt} widths={[480, 750, 1500]} sizes="(max-width: 782px) 100vw, 750px" format="webp" loading="lazy" /></p>
    </div>
  </main>
</Base>
