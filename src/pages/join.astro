---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

// Mailing list: signup is a club-owned Google Form; wording is edited under "Join page" in the CMS.
const page = (await getEntry('pages', 'join'))!.data as Record<string, any>;
const site = (await getEntry('settings', 'site'))!.data;
const groupMe = site.qr_links.find((q: { label: string }) => q.label === 'GroupMe');
---

<Base title={page.seo_title} description={page.seo_description}>
  <main class="site" id="main">
    <h1 class="page-title">{page.heading}</h1>
    {page.signup_url ? (
      <>
        {page.intro_text && <p class="lede">{page.intro_text}</p>}
        <div class="cta-actions">
          <a class="btn btn--primary" href={page.signup_url}>{page.signup_label ?? 'Sign up'}</a>
        </div>
        {page.privacy_note && <p class="cta-note">{page.privacy_note}</p>}
      </>
    ) : (
      // No Google Form linked yet: the mailing-list pill is a placeholder (goes to the 404)
      // until signup_url is set, and the GroupMe carries announcements in the meantime.
      <>
        {page.fallback_text && <p class="lede">{page.fallback_text}</p>}
        <div class="cta-actions">
          <a class="btn btn--primary" href="/404">{page.signup_label ?? 'Join the mailing list'}</a>
          {groupMe && <a class="btn btn--secondary" href={groupMe.url}>Join the GroupMe</a>}
        </div>
      </>
    )}
  </main>
</Base>
