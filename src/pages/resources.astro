---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = (await getEntry('pages', 'resources'))!.data as Record<string, any>;
---

<Base title={page.seo_title} description={page.seo_description}>
  <main class="site">
    <h2>{page.projects_heading}</h2>
    <p><a href={page.projects_form_url}>{page.projects_form_label}</a></p>
    <div class="embed">
      <iframe src={page.projects_sheet_src} style="border:solid 1px #007ea3" frameborder="0" scrolling="yes" loading="lazy"></iframe>
    </div>
  </main>
</Base>
