# Read by Netlify and Cloudflare Pages; vercel.json carries the same rules for Vercel.
# Basic security headers (these govern our pages only; the calendar/Sheets/Instagram embeds we load are unaffected)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Long-lived caching for Astro's hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
